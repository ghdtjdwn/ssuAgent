# Upstream MCP server
SSUMCP_URL=https://ssumcp.duckdns.org/mcp

# LangGraph PostgreSQL checkpointer
DATABASE_URL=postgresql://ssuai:dev@localhost:5432/ssuai
AGENT_PG_POOL_MAX_SIZE=5

# Configure at least one provider. Never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=

# Local HTTP boundary. Production requires a non-empty shared key.
AGENT_API_KEY=
AGENT_API_KEY_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:3000
AGENT_RATE_LIMIT=30/minute
AGENT_MAX_REQUEST_BYTES=32768
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_CONVERSATION_RETENTION_DAYS=30
AGENT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
AGENT_RETENTION_CLEANUP_BATCH_SIZE=100
AGENT_STORAGE_TIMEOUT_SECONDS=2
AGENT_CAPABILITY_SCRUB_BATCH_SIZE=500
AGENT_CAPABILITY_SCRUB_MAX_ROWS=100000
